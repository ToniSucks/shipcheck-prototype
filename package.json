{
  "name": "shipcheck",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev -w @shipcheck/web",
    "build": "npm run build -w @shipcheck/web",
    "start": "npm run start -w @shipcheck/web",
    "scan": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "browsers:install": "playwright install chromium",
    "format": "prettier --write \"apps/web/app/**/*.{ts,tsx,css}\" \"apps/web/lib/**/*.ts\" apps/web/proxy.ts \"packages/*/src/**/*.ts\" \"tests/**/*.ts\" *.json *.mjs *.ts README.md CONTRIBUTING.md .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0",
    "playwright": "^1.56.1",
    "zod": "^4.1.0"
  },
  "type": "module"
}
